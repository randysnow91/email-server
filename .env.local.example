# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase (Project Settings > API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin access gate (any long random string — see docs/V1_BUILD-SPEC.MD §4.1)
ADMIN_ACCESS_SECRET=change-me

# Mailgun (not needed until M3 — leave blank for now)
MAILGUN_API_KEY=
MAILGUN_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

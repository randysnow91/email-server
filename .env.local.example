# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase (Project Settings > API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin access gate (any long random string — see docs/V1_BUILD-SPEC.MD §4.1)
ADMIN_ACCESS_SECRET=change-me

# Mailgun (Sending > API Keys / Sending > Domains in your Mailgun dashboard)
# Sandbox domain works instantly but only sends to authorized-recipient
# addresses; a verified custom domain (e.g. mg.yourdomain.com) sends to anyone.
MAILGUN_API_KEY=your-private-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
# "Display Name <address>" format works directly - quote it since it has spaces.
MAILGUN_FROM_EMAIL="Your Newsletter <newsletter@mg.yourdomain.com>"
# Only needed if your Mailgun account is EU-region:
# MAILGUN_API_BASE_URL=https://api.eu.mailgun.net

# App - the public origin, no trailing slash. Baked in at build time
# (NEXT_PUBLIC_ prefix), and used to build the unsubscribe links in sent
# email, so on Render it must be the live URL and set before the build.
NEXT_PUBLIC_APP_URL=http://localhost:3000
